[Unit]
Description=Polaris CC iPhone web frontend
After=network-online.target ccc-server.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/polaris-cc
Environment=NODE_ENV=production
Environment=POLARIS_HOST=127.0.0.1
Environment=POLARIS_PORT=8796
Environment=POLARIS_STATIC_DIR=/home/ubuntu/polaris-cc/dist
Environment=CCC_BACKEND=http://127.0.0.1:8795
ExecStart=/usr/bin/node /home/ubuntu/polaris-cc/server/cccompanion-web.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
